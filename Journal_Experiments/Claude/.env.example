# =============================================================================
# CATSEC x AgentDojo -- environment template
# Copy to `.env` in the same directory as run_catsec_claude.py:
#     cp .env.example .env
# Then fill in the values below. `.env` is read by python-dotenv via
# load_dotenv() inside ensure_anthropic_env(). NEVER commit `.env`.
# =============================================================================

# --- REQUIRED: the only secret this runner needs -----------------------------
# Create at https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# --- OPTIONAL: Anthropic SDK knobs (read by the SDK itself, not by the runner)
# Leave unset unless you have a specific reason.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_LOG=warn            # debug | info | warn — SDK-level HTTP logging

# --- OPTIONAL: other provider legs, if you run them from this same directory --
# Only needed by the SIBLING runners; run_catsec_claude.py ignores these.
# OPENAI_API_KEY=sk-proj-REPLACE_ME                 # run_catsec_openai.py
# GOOGLE_CLOUD_PROJECT=my-project-id                # run_catsec_gemini_vertex.py
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- OPTIONAL: quality-of-life ------------------------------------------------
# Silences the HF tokenizers fork warning that agentdojo's deps sometimes emit.
# TOKENIZERS_PARALLELISM=false
