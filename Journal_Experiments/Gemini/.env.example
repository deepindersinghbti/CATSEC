# ---------------------------------------------------------------------------
# CATSEC experiment -- environment template
#
# Copy to .env and fill in. .env must be in .gitignore; .env.example (this
# file, with no real values) is the one that gets committed.
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Gemini via GOOGLE AI STUDIO (run_catsec_gemini.py) ---------------------
# Create a key at https://aistudio.google.com/app/apikey
# This is a plain bearer token: no gcloud login, no project, no location.
GEMINI_API_KEY=

# Force the AI Studio path. google-genai will otherwise fall back to Vertex if
# it finds Application Default Credentials or GOOGLE_CLOUD_PROJECT in the
# environment -- which on this machine it may well do, since the Vertex leg was
# run here. That fallback is silent, and it would put the run straight back on
# Dynamic Shared Quota. The runner sets this itself as well; keeping it here
# means anything else you run in this shell behaves the same way.
GOOGLE_GENAI_USE_VERTEXAI=false

# --- Other legs (only needed if you re-run them) ----------------------------
# OpenAI leg -- run_catsec_openai.py
OPENAI_API_KEY=

# Claude leg -- run_catsec_claude.py
ANTHROPIC_API_KEY=

# Gemini via VERTEX -- run_catsec_gemini_vertex.py (superseded by the AI Studio
# runner above; kept only so the old leg stays reproducible). Needs
# `gcloud auth application-default login` once beforehand.
GCP_PROJECT=
GCP_LOCATION=global
